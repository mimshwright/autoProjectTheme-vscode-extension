{
  "name": "auto-project-theme",
  "displayName": "Auto Project Theme",
  "description": "Automatically assigns random color themes to new projects",
  "version": "1.0.0",
  "publisher": "mimswright",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "icon": "./assets/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "repository": "https://github.com/mimshwright/autoProjectTheme-vscode-extension",
  "main": "./out/extension.js",
  "license": "MIT",
  "keywords": [
    "theme",
    "random",
    "switcher",
    "customization"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Auto Project Theme",
      "properties": {
        "autoProjectTheme.autoTriggerOnWindowOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically assign a theme when a folder is opened"
        },
        "autoProjectTheme.randomThemePool": {
          "type": "array",
          "default": [],
          "description": "List of color themes to randomly select from (light and dark are detected automatically)"
        },
        "autoProjectTheme.useAllInstalledThemes": {
          "type": "boolean",
          "default": false,
          "description": "Use all installed themes instead of only those in the random theme pool"
        }
      }
    },
    "commands": [
      {
        "command": "autoProjectTheme.addCurrentTheme",
        "title": "AutoProjectTheme: Edit theme pool"
      },
      {
        "command": "autoProjectTheme.selectNewTheme",
        "title": "AutoProjectTheme: Select a different random theme for this project"
      },
      {
        "command": "autoProjectTheme.toggleUseAllThemes",
        "title": "AutoProjectTheme: Toggle use all installed themes"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.120.0",
    "@vscode/vsce": "^3.9.1",
    "prettier": "^3.8.3",
    "typescript": "^5.0.0"
  }
}
